# Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

ROUTER_MODEL=gemini-3.5-flash-lite
SPECIALIST_MODEL=gemini-3.5-flash

# Optional: the vertex-alloydb-rag service. Unset = local keyword search over data/docs.
RAG_API_URL=

# Optional: gemini-mcp-db-server (read-only business data). Unset = no data_agent.
# Local: http://127.0.0.1:8080/mcp   Cloud Run: https://mcp-db-server-xxxx.run.app/mcp (agent SA needs run.invoker)
MCP_DB_URL=
# ADK's MCP client probes Google credentials for mTLS on every connection. Off Google Cloud that's slow.
GOOGLE_API_USE_CLIENT_CERTIFICATE=false

# Sessions. Local default is SQLite. On Cloud Run: postgresql+asyncpg://user:pass@10.x.x.x:5432/adk
SESSION_DB_URL=sqlite+aiosqlite:///./sessions.db

ALLOWED_SERVICES=orders-api,payments-api,inventory-api
MAX_TOOL_CALLS_PER_TURN=6
