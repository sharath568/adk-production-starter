      "conversation": [
        {
          "invocationId": "rollback-1",
          "userContent": {
            "parts": [
              {
                "text": "How do I roll back a bad deploy of orders-api?"
              }
            ],
            "role": "user"
          },
          "finalResponse": {
            "parts": [
              {
                "text": "Send 100 percent of traffic to the previous revision: `gcloud run services update-traffic orders-api --to-revisions=PREVIOUS=100`. Rollbacks don't need a change ticket (deploys.md#Rollback)."
              }
            ],
            "role": "model"
